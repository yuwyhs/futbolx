:80 {
    root * /usr/share/caddy
    encode gzip zstd

    # Special static files
    handle /assets/* {
        file_server
    }
    handle /sw.js {
        file_server
    }
    handle /manifest.json {
        file_server
    }

    # API routes (exactly like your Vercel setup)
    handle /api/* {
        rewrite /api/stream      /api/stream.json
        rewrite /api/stream-24-7 /api/stream-24-7.json
        try_files {path} {path}.json {path}.js
        file_server
    }

    # Page rewrites
    rewrite /auth/login   /auth/login.html
    rewrite /auth/signup  /auth/signup.html
    rewrite /dashboard    /dashboard.html
    rewrite /vip          /vip.html
    rewrite /24-7         /24-7.html

    # Live SPA pages
    handle /live/* {
        rewrite * /live.html
    }
    handle /live-24-7/* {
        rewrite * /live-24-7.html
    }

    # Everything else → SPA index.html (your main catch-all)
    handle {
        try_files {path} /index.html
        file_server
    }
}
