{
  "version": 2,
  "builds": [
    // Static HTML files (root + auth folder)
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "auth/*.html",
      "use": "@vercel/static"
    },
    // Assets, API, and other static files
    {
      "src": "assets/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.json",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    // Serve static assets
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    // Serve API routes
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    // Specific static JSON endpoints
    {
      "src": "/api/stream",
      "dest": "/api/stream.json"
    },
    {
      "src": "/api/stream-24-7",
      "dest": "/api/stream-24-7.json"
    },
    // Auth pages
    {
      "src": "/auth/login",
      "dest": "/auth/login.html"
    },
    {
      "src": "/auth/signup",
      "dest": "/auth/signup.html"
    },
    // Dashboard page
    {
      "src": "/dashboard",
      "dest": "/dashboard.html"
    },
    // Live stream pages
    {
      "src": "/live/(.*)",
      "dest": "/live.html"
    },
    {
      "src": "/live-24-7/(.*)",
      "dest": "/live-24-7.html"
    },
    // Other static pages
    {
      "src": "/vip",
      "dest": "/vip.html"
    },
    {
      "src": "/24-7",
      "dest": "/24-7.html"
    },
    // Catch-all: send everything else to index.html (SPA-style)
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
    }
