{
  "version": 2,
  "builds": [
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/*.json",
      "use": "@vercel/static"
    },
    {
      "src": "*.json",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },

    // Serve ANY file that ends with .json inside /api/ directly
    {
      "src": "/api/(.+\\.json)",
      "dest": "/api/$1"
    },

    // Optional: redirect old /api/stream without .json
    {
      "src": "/api/stream",
      "dest": "/api/stream.json"
    },

    // Your other 24/7 file if it exists
    {
      "src": "/api/stream-24-7",
      "dest": "/api/stream-24-7.json"
    },

    {
      "src": "/live/(.*)",
      "dest": "/live.html"
    },
    {
      "src": "/live-24-7/(.*)",
      "dest": "/live-24-7.html"
    },
    {
      "src": "/vip",
      "dest": "/vip.html"
    },
    {
      "src": "/24-7",
      "dest": "/24-7.html"
    },

    // SPA catch-all — last rule
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
    }
