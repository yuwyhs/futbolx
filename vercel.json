{
  "version": 2,
  "builds": [
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    },
    {
      "src": "*.json",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/stream.json",
      "dest": "/stream.json"
    },
    {
      "src": "/live/(.*)",
      "dest": "/live.html"
    },
    {
      "src": "/vip",
      "dest": "/vip.html"
    },
    {
      "src": "/(request|vods|auth/login|changelog|contact)",
      "status": 404,
      "dest": "/404.html"
    },
    {
      "src": "/api/(.*)",
      "dest": "/stream.json"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
