{
  "version": 2,
  "builds": [
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "auth/*.html", "use": "@vercel/static" },
    { "src": "assets/**", "use": "@vercel/static" },
    { "src": "api/*.json", "use": "@vercel/static" },
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "*.json", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/sw.js", "dest": "/sw.js" },
    { "src": "/manifest.json", "dest": "/manifest.json" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/api/(.+\\.json)", "dest": "/api/$1" },
    { "src": "/api/stream", "dest": "/api/stream.json" },
    { "src": "/api/stream-24-7", "dest": "/api/stream-24-7.json" },
    { "src": "/api/token", "dest": "/api/token.js" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/auth/login", "dest": "/auth/login.html" },
    { "src": "/auth/signup", "dest": "/auth/signup.html" },
    { "src": "/dashboard", "dest": "/dashboard.html" },
    { "src": "/live/(.*)", "dest": "/live.html" },
    { "src": "/live-24-7/(.*)", "dest": "/live-24-7.html" },
    { "src": "/vip", "dest": "/vip.html" },
    { "src": "/24-7", "dest": "/24-7.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
